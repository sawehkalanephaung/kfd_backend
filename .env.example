# Template only — copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER put a real credential in this file: .env.example
# is committed, so anything here is published to everyone with repository access
# and stays in git history permanently, even after it is removed.
#
# Read by both docker-compose.yml and the application itself
# (spring.config.import in application.properties), so one file serves both.
#
# Precedence: a real environment variable (Docker, CI, Elastic Beanstalk) beats
# a value here, which beats the fallback defaults in application.properties.

# ─── Database ───
# Used by docker-compose to provision Postgres, and by the app to connect.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ─── Resend Email API ───
# https://resend.com/api-keys — the key starts with `re_`.
# Leave blank locally to skip sending; password-reset links are logged instead.
RESEND_API_KEY=
EMAIL_TO=

# ─── JWT Signing Key ───
# Generate your own — never reuse a value from a tutorial or another environment:
#   openssl rand -base64 32
# Leave unset locally to get an ephemeral per-boot key. Required in production,
# where it is supplied as an Elastic Beanstalk environment variable.
JWT_SECRET_KEY=
