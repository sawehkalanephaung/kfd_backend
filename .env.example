# ─── Database ───
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here

# ─── Resend Email API ───
RESEND_API_KEY=re_YOUR_API_KEY_HERE
EMAIL_TO=your-staff-email@example.com

# ─── JWT Signing Key ───
# Generate your own — never reuse a value from a tutorial or another environment:
#   openssl rand -base64 32
# Leave unset locally to get an ephemeral per-boot key. Required in production.
JWT_SECRET_KEY=
